# Disable script execution across all upload subdirectories
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Treat any script-like files as plain text
AddType text/plain .php .php3 .php4 .php5 .php7 .php8 .phtml .phps .pl .py .cgi .sh .bash .phar

# Block direct web access to executable extensions
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps|pl|py|cgi|sh|bash|phar|exe|bat|cmd)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent directory indexing
Options -Indexes
