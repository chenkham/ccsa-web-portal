# Centre for Computer Science and Applications (CCSA), Dibrugarh University
# Production Server Configuration & Security Rules

# 1. Directory Index & Fallback (Prioritize index.php)
DirectoryIndex index.php index.html
Options -Indexes +FollowSymLinks
ErrorDocument 404 /404.php

# 2. URL Rewriting & Google Sitelinks Aliasing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Google Search Sitelink Normalizations
    RewriteRule ^notifications/?$ /notices.php [R=301,L]
    RewriteRule ^all-notifications/?$ /notices.php [R=301,L]
    RewriteRule ^all_notifications/?$ /notices.php [R=301,L]
    RewriteRule ^document/?$ /notices.php [R=301,L]
    RewriteRule ^documents/?$ /notices.php [R=301,L]
    RewriteRule ^bca/?$ /undergraduate.php [R=301,L]
    RewriteRule ^mca/?$ /postgraduate.php [R=301,L]
    RewriteRule ^students/?$ /Present_Stu.php [R=301,L]
    RewriteRule ^present-students/?$ /Present_Stu.php [R=301,L]
    RewriteRule ^present_students/?$ /Present_Stu.php [R=301,L]
    RewriteRule ^present_stu/?$ /Present_Stu.php [R=301,L]

    # Legacy .html to .php Redirection
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^(.*)\.html$ /$1.php [R=301,L]

    # Clean URL support (extensionless PHP files)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^([^/]+)/?$ $1.php [L]
</IfModule>

# 3. Block Access to Hidden & Sensitive Files
<FilesMatch "(^\.|\.(sql|env|bak|log|ini|sh|md|git))$">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Global Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# 4. Enable GZIP & Deflate Compression for High Speed Loading
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5. Browser Caching Rules for Static Assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType application/pdf "access plus 1 day"
</IfModule>

# 6. Default Charset
AddDefaultCharset UTF-8
