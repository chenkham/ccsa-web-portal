# Production Security Headers (GIGW 3.0 & OWASP Compliant)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

RewriteEngine On

# Block direct access to PHP include files & cache
RewriteRule ^src/includes/ - [F,L]
RewriteRule ^src/templates/ - [F,L]
RewriteRule ^src/cache/ - [F,L]

# Redirect /admin to admin panel
RewriteCond %{REQUEST_URI} ^/admin/?$
RewriteRule ^ /src/admin/index.php [L]

# Transparently route any .html request to corresponding .php if .php exists
RewriteCond %{DOCUMENT_ROOT}/src/$1.php -f
RewriteRule ^src/([^/]+)\.html$ /src/$1.php [L]

RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^([^/]+)\.html$ /$1.php [L]

# Do not rewrite if already inside /src
RewriteCond %{REQUEST_URI} !^/src/

# Redirect everything else to /src
RewriteRule ^(.*)$ /src/$1 [L]

# Default file
DirectoryIndex /src/index.php /src/index.html